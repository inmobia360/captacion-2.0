# ==========================================
# CompraCaptación - Environment Configuration
# ==========================================
APP_ENV=production
APP_URL=https://compracaptacion.com

# Database Configuration
DB_DRIVER=sqlite
DB_PATH=data/captacion.sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=u560645602_captacion
# DB_USER=u560645602_user
# DB_PASS=your_secure_db_password

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_random_key_here_at_least_32_chars
SESSION_LIFETIME_HOURS=72

# Staff seed credentials
CAPTACION_MASTER_ADMIN_EMAIL=admin@example.com
CAPTACION_MASTER_ADMIN_PASSWORD=replace_with_a_long_random_secret
CAPTACION_SEED_PREMIUM_EMAIL=
CAPTACION_SEED_PREMIUM_PASSWORD=
CAPTACION_SEED_USER_PASSWORD=
CAPTACION_TEMP_USER_EMAIL=
CAPTACION_TEMP_USER_PASSWORD=
CAPTACION_TEMP_USER_NAME=
CAPTACION_TEMP_USER_AGENCY=

# Stripe Payments & Webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_CREDIT_SINGLE=price_test_credit_single
STRIPE_PRICE_AUTONOMO_MONTHLY=price_test_autonomo_monthly
STRIPE_PRICE_AUTONOMO_ANNUAL=price_test_autonomo_annual
STRIPE_PRICE_AGENCIA_MONTHLY=price_test_agencia_monthly
STRIPE_PRICE_AGENCIA_ANNUAL=price_test_agencia_annual
STRIPE_PRICE_BROKER_MONTHLY=price_test_broker_monthly
STRIPE_PRICE_BROKER_ANNUAL=price_test_broker_annual

# AI Vera Engine
AI_DEFAULT_PROVIDER=openrouter
VERA_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
GROQ_API_KEY=gsk_your_groq_api_key

# n8n Automation & Webhooks
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/captacion-leads
N8N_WEBHOOK_AUTH_TOKEN=your_secure_bearer_auth_token_for_n8n
